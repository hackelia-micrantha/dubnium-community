{"openapi":"3.1.2","info":{"title":"Dubnium Scheduler API","version":"0.1.0","description":"Experimental HTTP transport binding for the current systemd-backed scheduler API. It exposes schedule inspection, journal history, and operator controls. Schedule persistence, systemd unit generation, concurrency, retry, and policy semantics remain implementation-defined. The current service does not enforce inbound authentication and must remain behind a trusted administrative boundary."},"servers":[{"url":"https://scheduler.example.invalid","description":"Illustrative deployment only"}],"tags":[{"name":"Health"},{"name":"Schedules"},{"name":"Operator"}],"paths":{"/healthz":{"get":{"operationId":"getSchedulerHealth","tags":["Health"],"summary":"Return process health","responses":{"200":{"description":"The scheduler API is running.","content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"type":"string","const":"ok"}}}}}}}}},"/schedules":{"get":{"operationId":"listSchedules","tags":["Schedules"],"summary":"List configured schedule summaries","responses":{"200":{"description":"Configured schedules.","content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["schedules"],"properties":{"schedules":{"type":"array","items":{"$ref":"#/components/schemas/ScheduleSummary"}}}}}}}}}},"/schedules/{schedule_id}":{"get":{"operationId":"getSchedule","tags":["Schedules"],"summary":"Get one schedule definition","parameters":[{"name":"schedule_id","in":"path","required":true,"schema":{"type":"string","minLength":1}}],"responses":{"200":{"description":"Schedule definition.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Schedule"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/schedules/{schedule_id}/history":{"get":{"operationId":"getScheduleHistory","tags":["Operator"],"summary":"Read recent systemd journal entries for a schedule","x-dubnium-visi