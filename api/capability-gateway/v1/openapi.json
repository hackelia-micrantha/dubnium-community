{
  "openapi": "3.1.2",
  "info": {
    "title": "Dubnium Capability Gateway v1alpha",
    "version": "0.1.0",
    "description": "Portable HTTP message binding only. Production authentication, listener profiles, socket paths, policy adapters, provider routing, and host deployment remain private."
  },
  "paths": {
    "/v1/capability-requests": {
      "post": {
        "operationId": "submitCapabilityRequest",
        "summary": "Submit one typed capability request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../schemas/v1/capability-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Logical request accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../schemas/v1/capability-submission.schema.json"
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/capability-requests/{request_id}": {
      "get": {
        "operationId": "getCapabilityRequestStatus",
        "summary": "Inspect one Gateway-level request status",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current Gateway-level status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../schemas/v1/capability-status.schema.json"
                }
              }
            }
          },
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getCapabilityGatewayHealth",
        "summary": "Return bounded service health",
        "responses": {
          "200": {
            "description": "Service is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "contract_versions"],
                  "properties": {
                    "status": {"type": "string", "const": "ok"},
                    "contract_versions": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "code", "retryable"],
        "properties": {
          "type": {"type": "string", "format": "uri", "maxLength": 512},
          "title": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"type": "integer", "minimum": 400, "maximum": 599},
          "detail": {"type": "string", "maxLength": 512},
          "instance": {"type": "string", "format": "uri", "maxLength": 512},
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "retryable": {"type": "boolean"},
          "field": {"type": "string", "minLength": 1, "maxLength": 128},
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "request_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 Problem Details with stable Dubnium code and retryability",
        "content": {
          "application/problem+json": {
            "schema": {"$ref": "#/components/schemas/Problem"}
          }
        }
      }
    }
  }
}
