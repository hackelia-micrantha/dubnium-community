{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubnium.dev/schemas/v1alpha/operator-client-credential-claims.schema.json",
  "title": "Dubnium Operator client credential claims v1alpha",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ver",
    "iss",
    "sub",
    "aud",
    "client_id",
    "client_class",
    "iat",
    "nbf",
    "exp",
    "jti",
    "token_type",
    "cnf",
    "scopes"
  ],
  "properties": {
    "ver": { "const": 1 },
    "iss": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sub": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aud": { "type": "string", "minLength": 1, "maxLength": 256 },
    "client_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "client_class": {
      "enum": ["mobile", "web", "desktop-agent"]
    },
    "iat": { "type": "integer", "minimum": 1 },
    "nbf": { "type": "integer", "minimum": 1 },
    "exp": { "type": "integer", "minimum": 1 },
    "jti": { "type": "string", "minLength": 1, "maxLength": 128 },
    "token_type": { "const": "DPoP" },
    "cnf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jkt"],
      "properties": {
        "jkt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "scopes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
