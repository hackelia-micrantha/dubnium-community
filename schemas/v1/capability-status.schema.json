{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.micrantha.com/dubnium/v1/capability-status.schema.json",
  "title": "CapabilityStatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "request_digest", "gateway_state", "updated_at"],
  "properties": {
    "$schema": {"type": "string", "maxLength": 512},
    "contract_version": {"const": "1.0"},
    "request_id": {"$ref": "common.schema.json#/$defs/requestId"},
    "request_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "gateway_state": {"enum": ["received", "validated", "policy-pending", "denied", "authorized", "dispatched", "succeeded", "failed", "indeterminate"]},
    "provider_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_ref", "operation_ref", "phase"],
      "properties": {
        "provider_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "operation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "phase": {"enum": ["accepted", "running", "completed", "failed", "indeterminate"]}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "evidence_refs"],
      "properties": {
        "output": {"$ref": "common.schema.json#/$defs/jsonObject"},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}}
      }
    },
    "error": {"$ref": "common.schema.json#/$defs/error"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"gateway_state": {"enum": ["dispatched", "succeeded", "failed", "indeterminate"]}}, "required": ["gateway_state"]},
      "then": {"required": ["provider_operation"]},
      "else": {"not": {"required": ["provider_operation"]}}
    },
    {
      "if": {"properties": {"gateway_state": {"const": "succeeded"}}, "required": ["gateway_state"]},
      "then": {"required": ["result"], "not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"gateway_state": {"enum": ["denied", "failed", "indeterminate"]}}, "required": ["gateway_state"]},
      "then": {"required": ["error"], "not": {"required": ["result"]}}
    },
    {
      "if": {"properties": {"gateway_state": {"enum": ["received", "validated", "policy-pending", "authorized", "dispatched"]}}, "required": ["gateway_state"]},
      "then": {"not": {"anyOf": [{"required": ["result"]}, {"required": ["error"]}]}}
    }
  ]
}
