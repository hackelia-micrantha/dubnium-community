{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.micrantha.com/dubnium/v1/capability-submission.schema.json",
  "title": "CapabilitySubmission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "outcome", "submitted_at"],
  "properties": {
    "$schema": {"type": "string", "maxLength": 512},
    "contract_version": {"const": "1.0"},
    "request_id": {"$ref": "common.schema.json#/$defs/requestId"},
    "outcome": {"enum": ["accepted", "rejected"]},
    "request_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "status_ref": {"$ref": "common.schema.json#/$defs/reference"},
    "error": {"$ref": "common.schema.json#/$defs/error"},
    "submitted_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "accepted"}}, "required": ["outcome"]},
      "then": {"required": ["request_digest", "status_ref"], "not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"outcome": {"const": "rejected"}}, "required": ["outcome"]},
      "then": {"required": ["error"], "not": {"required": ["status_ref"]}}
    }
  ]
}
