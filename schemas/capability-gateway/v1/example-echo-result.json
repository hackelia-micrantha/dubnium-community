{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.micrantha.com/dubnium/capability-gateway/v1/example-echo-result.json",
  "title": "example.echo result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messages",
    "output_bytes",
    "request_digest"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "request_digest": {
      "$ref": "common.json#/$defs/digest"
    }
  }
}
