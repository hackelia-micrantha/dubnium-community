{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.micrantha.com/dubnium/capability-gateway/v1/error.json",
  "title": "Capability Gateway v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_json",
        "duplicate_key",
        "body_too_large",
        "unsupported_contract_version",
        "unsupported_capability_version",
        "schema_validation_failed",
        "invalid_timestamp",
        "request_id_conflict",
        "request_not_found",
        "capability_not_admitted",
        "governance_denied",
        "governance_indeterminate",
        "manifest_invalid",
        "manifest_expired",
        "manifest_widening",
        "provider_failed",
        "state_limit_exceeded",
        "internal_error"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "detail": {
      "type": "string",
      "maxLength": 512
    },
    "instance": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "request_id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "request_digest": {
      "$ref": "common.json#/$defs/digest"
    }
  }
}
